# WalletConnect project ID — get one free at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_project_id_here

# Resource delivery secret — generate with: openssl rand -hex 32
UNLOCK_SIGNING_SECRET=replace_with_random_secret_min_32_chars

# ProofRails main app (for receipt creation server-side)
PROOFRAILS_API_BASE=https://app.proofrails.com
PROOFRAILS_API_KEY=your_api_key_here

# SQLite database directory (default: ./data)
# DATABASE_DIR=./data

# Resource storage (default: ./resources/private)
# RESOURCE_PRIVATE_DIR=./resources/private
