# Flare USDT0 x402 Agent — environment variables

# ProofRails API base URL
API_BASE_URL=http://localhost:8000

# Flare mainnet RPC
FLARE_RPC_URL=https://flare-api.flare.network/ext/C/rpc

# USDT0 token contract on Flare mainnet (do not change)
USDT0_ADDRESS=0xe7cd86e13AC4309349F30B3435a9d337750fC82D

# Deployed X402Facilitator contract address (deploy via scripts/deploy_x402_facilitator.js)
FACILITATOR_ADDRESS=0xYourDeployedFacilitatorAddress

# Agent wallet private key (must hold USDT0 on Flare mainnet)
AGENT_PRIVATE_KEY=0xYourAgentPrivateKey
